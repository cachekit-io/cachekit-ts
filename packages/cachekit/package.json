{
  "name": "@cachekit-io/cachekit",
  "version": "0.1.3",
  "description": "TypeScript SDK for CacheKit - Production-ready Redis caching with zero-knowledge encryption",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./backends/file": {
      "import": {
        "types": "./dist/backends/file.d.ts",
        "default": "./dist/backends/file.js"
      },
      "require": {
        "types": "./dist/cjs/backends/file.d.ts",
        "default": "./dist/cjs/backends/file.js"
      }
    },
    "./backends/memcached": {
      "import": {
        "types": "./dist/backends/memcached.d.ts",
        "default": "./dist/backends/memcached.js"
      },
      "require": {
        "types": "./dist/cjs/backends/memcached.d.ts",
        "default": "./dist/cjs/backends/memcached.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:protocol": "vitest run test/protocol",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "cache",
    "redis",
    "caching",
    "encryption",
    "typescript",
    "zero-knowledge"
  ],
  "author": "CacheKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cachekit-io/cachekit-ts.git",
    "directory": "packages/cachekit"
  },
  "homepage": "https://cachekit.io",
  "bugs": {
    "url": "https://github.com/cachekit-io/cachekit-ts/issues"
  },
  "dependencies": {
    "@cachekit-io/cachekit-core-ts": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.0.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@testcontainers/redis": "^11.13.0",
    "@types/ioredis": "^5.0.0",
    "@types/memjs": "^1.3.3",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "memjs": "^1.3.2",
    "prom-client": "^15.1.3",
    "testcontainers": "^11.13.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "memjs": ">=1.3.0",
    "prom-client": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "memjs": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  }
}
