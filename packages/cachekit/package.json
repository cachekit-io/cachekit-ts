{
  "name": "@cachekit-io/cachekit",
  "version": "0.1.0",
  "description": "TypeScript SDK for CacheKit - Production-ready Redis caching with zero-knowledge encryption",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "test:protocol": "vitest run test/protocol",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "cache",
    "redis",
    "caching",
    "encryption",
    "typescript",
    "zero-knowledge"
  ],
  "author": "CacheKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cachekit-io/cachekit-ts.git",
    "directory": "packages/cachekit"
  },
  "homepage": "https://cachekit.io",
  "bugs": {
    "url": "https://github.com/cachekit-io/cachekit-ts/issues"
  },
  "dependencies": {
    "@cachekit-io/cachekit-core-ts": "workspace:*",
    "@msgpack/msgpack": "^3.1.2",
    "@noble/hashes": "^2.0.1",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@testcontainers/redis": "^11.9.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.15.0",
    "prom-client": "^15.1.3",
    "testcontainers": "^11.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "prom-client": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  }
}
