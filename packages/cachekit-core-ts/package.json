{
  "name": "@cachekit-io/cachekit-core-ts",
  "version": "0.1.0",
  "description": "Native Rust bindings for CacheKit TypeScript SDK (serialization, compression, encryption)",
  "main": "./index.js",
  "types": "./index.d.ts",
  "napi": {
    "binaryName": "cachekit-core-ts",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal",
    "version": "napi version",
    "clean": "rm -rf target/ *.node"
  },
  "keywords": [
    "napi",
    "rust",
    "native",
    "bindings",
    "serialization",
    "compression",
    "encryption"
  ],
  "author": "CacheKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cachekit-io/cachekit-ts.git",
    "directory": "packages/cachekit-core-ts"
  },
  "homepage": "https://cachekit.io",
  "bugs": {
    "url": "https://github.com/cachekit-io/cachekit-ts/issues"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.1",
    "@types/node": "^25.5.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
